rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A request is the owner when it is authenticated and its uid matches.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // A user may read and write anything under their own document tree
    // (their profile doc plus the /decks subcollection). Recursive wildcard
    // so decks and any future per-user data are covered by one rule.
    //
    // NOTE: these rules must be DEPLOYED to take effect:
    //   firebase deploy --only firestore:rules
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
